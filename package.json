{
  "name": "pybricsownedytor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run copy-media && vite",
    "copy-media": "mkdir -p public/blockly-media && cp -R node_modules/blockly/media/. public/blockly-media/",
    "build": "npm run copy-media && tsc && vite build",
    "preview": "vite preview"
  },
  "description": "Uproszczony edytor blokowy na LEGO SPIKE Prime z firmware Pybricks",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@pybricks/mpy-cross-v6": "^2.0.0",
    "blockly": "^13.3.0",
    "lucide-react": "^1.48.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
